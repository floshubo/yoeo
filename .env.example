AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# json_schema, json_object, or none. All responses are validated server-side.
AI_RESPONSE_FORMAT=json_schema
# Optional Windows development fallback when Node cannot reach the provider but Windows can.
AI_WINDOWS_HTTP=false
PORT=5187
# Optional shared access token for a public deployment. Leave empty for local use.
APP_ACCESS_TOKEN=
# NODE_ENV=production enforces the three-scan account limit. Local built previews stay unlimited.
NODE_ENV=development
# HTTPS origin of the deployed YOEO API for bundled iOS/Android builds. Leave empty for local web development.
VITE_API_BASE_URL=
# Comma-separated Capacitor origins accepted by the API. Keep this exact list in production.
NATIVE_APP_ORIGINS=capacitor://localhost,http://localhost
# RevenueCat client keys. The test key works only with RevenueCat Test Store builds.
VITE_REVENUECAT_TEST_API_KEY=
# Replace these with the public SDK keys for the App Store and Google Play before release.
VITE_REVENUECAT_IOS_API_KEY=
VITE_REVENUECAT_ANDROID_API_KEY=
# Server-side entitlement lookup used by the scan quota. A RevenueCat public SDK key is sufficient for GET /subscribers.
REVENUECAT_SERVER_API_KEY=
REVENUECAT_ENTITLEMENT_ID=yoeo_pro
# Use 1 only behind the hosting provider's single trusted reverse proxy.
TRUST_PROXY_HOPS=0
# Cloud accounts (server-only).
APP_URL=http://localhost:5187
# Public HTTPS origin of the API, when different from APP_URL (needed for native OAuth callback).
API_PUBLIC_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required in production for account sync and checking an authenticated Pro entitlement. Never use a VITE_ prefix.
# Generate a unique random secret of at least 32 characters before enabling auth.
SESSION_SECRET=
AUTH_GOOGLE_ENABLED=false
AUTH_APPLE_ENABLED=false
# Google/Apple client IDs and secrets are entered in Supabase Authentication → Providers,
# not in this app's .env. Enable each flag only after its Supabase provider is configured.
# Email OTP uses Supabase Authentication → Email plus custom SMTP (for example Resend).
# SMTP credentials belong in Supabase, not in this app's .env.
# Set HOST=0.0.0.0 to accept connections from your local network.
# For native Gemini: AI_PROVIDER=gemini, AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# and AI_MODEL=gemini-2.5-flash. Use your Gemini key as AI_API_KEY.
# Other providers: set their OpenAI-compatible base URL and a supported vision model.
# Text-only models can analyze pasted menu text, but cannot process photo uploads.
