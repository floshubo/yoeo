{
  "name": "yoeo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "preview:purchases": "node scripts/purchase-preview.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc -b",
    "native:doctor": "cap doctor",
    "native:add:ios": "pnpm build && cap add ios",
    "native:add:android": "pnpm build && cap add android",
    "native:sync": "pnpm build && cap sync",
    "native:assets": "capacitor-assets generate --iconBackgroundColor '#366823' --iconBackgroundColorDark '#366823' --splashBackgroundColor '#366823' --splashBackgroundColorDark '#366823'",
    "native:bundle:android": "pwsh -NoProfile -File scripts/build-android-release.ps1",
    "native:open:ios": "cap open ios",
    "native:open:android": "cap open android",
    "native:prepare:ios": "node scripts/prepare-ios.mjs",
    "native:test:ios": "tsc -b && vite build --mode revenuecat-test && cap sync ios",
    "native:archive:ios": "bash scripts/archive-ios.sh",
    "native:ipa:ios": "bash scripts/build-ios-ipa.sh"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource-variable/geologica": "^5.2.0",
    "@revenuecat/purchases-capacitor": "^13.5.0",
    "@revenuecat/purchases-capacitor-ui": "^13.5.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "openai": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
